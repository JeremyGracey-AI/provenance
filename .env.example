# Copy to .env (gitignored) for local runs, or set these in the Vercel API project.
# Names are PROVENANCE_-prefixed because config.Settings uses env_prefix="PROVENANCE_".

# Query embeddings (Cohere Embed v4). Required for the real pipeline + build_index.py.
PROVENANCE_COHERE_API_KEY=

# VLM answer + verify (Claude vision). If unset, the SDK falls back to ANTHROPIC_API_KEY.
PROVENANCE_ANTHROPIC_API_KEY=

# Current vision-capable Claude model id (see Anthropic's model list).
PROVENANCE_VLM_MODEL=claude-sonnet-4-6

# HF resolve base for the page images (must be a PUBLIC dataset):
# https://huggingface.co/datasets/<user>/<repo>/resolve/main/pages
PROVENANCE_PAGES_BASE_URL=

# WEB project only: the deployed API project's URL.
# NEXT_PUBLIC_API_URL=https://<your-api-project>.vercel.app
